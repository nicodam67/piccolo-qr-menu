{
  "name": "piccolo-qr-menu",
  "version": "1.0.0",
  "description": "Prototipo visual público móvil de Piccolo QR Menu",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --conditions=react-server --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:importer": "tsx --test tests/unit/hercules-importer.test.ts",
    "hercules:inspect": "tsx src/features/hercules-import/cli.ts inspect",
    "hercules:import": "tsx src/features/hercules-import/cli.ts import",
    "hercules:validate-db": "tsx src/features/hercules-import/cli.ts validate-db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed-demo.ts",
    "db:admin:create": "tsx src/db/create-admin.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicodam67/piccolo-qr-menu.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nicodam67/piccolo-qr-menu/issues"
  },
  "homepage": "https://github.com/nicodam67/piccolo-qr-menu#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "argon2": "^0.45.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "esbuild": "$esbuild"
  }
}
