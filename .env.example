# PostgreSQL local de desarrollo. Sustituir usuario, contraseña, host y base
# según el entorno. Nunca subir el archivo .env real al repositorio.
DATABASE_URL=postgresql://piccolo:piccolo@localhost:5432/piccolo_qr_menu

# Protección del seed demo. Solo usar "true" como autorización explícita y
# excepcional cuando NODE_ENV=production.
ALLOW_DEMO_SEED=false

# Firma de sesiones. Generar al menos 32 bytes de entropía aleatoria:
# openssl rand -base64 48
AUTH_SECRET=
AUTH_SESSION_TTL_SECONDS=28800

# URL canónica pública, sin barra final.
NEXT_PUBLIC_SITE_URL=

# Solo se leen al ejecutar `npm run db:admin:create`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_UPDATE_EXISTING=false

# Imágenes: "local" solo para desarrollo; usar "s3" en producción.
IMAGE_STORAGE_DRIVER=local

# Configuración S3-compatible para producción.
IMAGE_S3_BUCKET=
IMAGE_S3_REGION=
IMAGE_S3_ENDPOINT=
IMAGE_S3_FORCE_PATH_STYLE=false
IMAGE_S3_ACCESS_KEY_ID=
IMAGE_S3_SECRET_ACCESS_KEY=
IMAGE_PUBLIC_BASE_URL=

# Estado recomendado durante el desarrollo actual. Stripe y Bizum se activarán
# en una fase futura, cuando el resto de módulos esté integrado.
PAYMENT_PROVIDER=disabled

# Configuración reservada para la fase final. No añadir claves reales al
# repositorio, no usar claves de producción durante desarrollo y no prefijar
# secretos con NEXT_PUBLIC_.
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
RESERVATION_CRON_SECRET=

# Integración TPV ↔ QR Menu. Generar un token de al menos 32 bytes y asignar
# solo los scopes necesarios al servicio consumidor.
INTEGRATION_SERVICE_TOKEN=
INTEGRATION_SERVICE_SCOPES=catalog:read,catalog:write
