# Desarrollo local (Compose construye su propia DATABASE_URL con POSTGRES_*).
DATABASE_URL=postgresql://piccolo:piccolo@localhost:5432/piccolo_qr_menu

# Protección del seed demo. Solo usar "true" como autorización explícita y
# excepcional cuando NODE_ENV=production.
ALLOW_DEMO_SEED=false

# Firma de sesiones. Generar al menos 32 bytes de entropía aleatoria:
# openssl rand -base64 48
AUTH_SECRET=
AUTH_SESSION_TTL_SECONDS=28800

# Solo se leen al ejecutar `npm run db:admin:create`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_UPDATE_EXISTING=false

# Despliegue oficial TerraMaster. Copiar este archivo como `.env`, sustituir
# los valores vacíos y no subir nunca el `.env` resultante al repositorio.
POSTGRES_DB=piccolo_qr_menu
POSTGRES_USER=piccolo
POSTGRES_PASSWORD=

# Dirección HTTPS publicada por Caddy. Puede ser la IP fija del NAS o un nombre
# DNS local que resuelva a ella. Cada cliente debe confiar en la CA local de Caddy.
PICCOLO_SITE_ADDRESS=https://192.168.1.196
PICCOLO_HTTP_PORT=80
PICCOLO_HTTPS_PORT=443
